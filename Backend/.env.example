# ─── SmartAssets Backend Environment Variables Template ────────────────────────
# Copy this file to .env and populate with genuine values for your deployment.
# NEVER commit real credentials, service-role keys, private keys, or signing secrets to git.

# Server Environment & Port
NODE_ENV=production
PORT=5000

# ==============================================================================
# 1. CORE REQUIRED CONFIGURATION (Server fails closed if missing in production)
# ==============================================================================

# Supabase Production Project
# Obtain from your Supabase dashboard: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Administrator Authentication & JWT Signing
# REQUIRED: Cryptographic HMAC-SHA256 secret for signing administrator session tokens.
# Must be at least 32 characters (256-bit entropy).
# Generate securely via terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse the Supabase service-role key or use predictable/default strings.
ADMIN_JWT_SECRET=

# External Public Base URL
# Canonical HTTPS base URL for public product certificate verification portal.
# In production: must be a public HTTPS domain (e.g. https://api.smartassets.io or https://smartassets-backend.onrender.com)
# In development: http://localhost:5000
PUBLIC_WEB_BASE_URL=https://smartassets-backend.onrender.com

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of permitted production origins (no wildcards allowed in production).
# Example: https://app.smartassets.io,https://admin.smartassets.io
CORS_ALLOWED_ORIGINS=https://app.smartassets.io,https://admin.smartassets.io

# Reverse Proxy & SSL Configuration
# TRUST_PROXY: Set to 1 for Render / Cloudflare / reverse proxy setups.
TRUST_PROXY=1
# ENFORCE_HSTS: Set to 'true' once production HTTPS is active and verified.
ENFORCE_HSTS=true

# ==============================================================================
# 2. CERTIFICATE AUTHORITY & PKI SIGNING (RSA-2048+)
# ==============================================================================
# Prevent restarts from replacing certificate signing keys.
# Generate a new 2048-bit RSA keypair securely via Node.js or OpenSSL:
#
# Terminal Generation (Node.js one-liner):
#   node -e "const { privateKey, publicKey } = require('crypto').generateKeyPairSync('rsa', { modulusLength: 2048, publicKeyEncoding: { type: 'spki', format: 'pem' }, privateKeyEncoding: { type: 'pkcs8', format: 'pem' } }); console.log('=== PRIVATE KEY ===\n' + privateKey); console.log('=== PUBLIC KEY ===\n' + publicKey);"
#
# Terminal Generation (OpenSSL):
#   openssl genpkey -algorithm RSA -out private_key.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private_key.pem -out public_key.pem

# Active RSA private key PEM (Paste entire PEM or replace newlines with \n for single-line env)
CERTIFICATE_SIGNING_PRIVATE_KEY=
# Corresponding RSA public key PEM (optional; derived automatically if omitted)
CERTIFICATE_SIGNING_PUBLIC_KEY=
# Active Key Identifier
CERTIFICATE_SIGNING_KEY_ID=sa-cert-key-2026-v1

# Historical Public Keys for Backward Compatibility (Optional)
# If rotating signing keys, retain older public keys so previously issued certificates verify.
# Format: JSON array of objects: [{"keyId": "sa-cert-key-2025-v1", "publicKeyPem": "-----BEGIN PUBLIC KEY...", "status": "retired"}]
CERTIFICATE_HISTORICAL_PUBLIC_KEYS_JSON=

# ==============================================================================
# 3. RATE LIMITING CONFIGURATION (Requests / Window in ms)
# ==============================================================================
# Administrator Login (dual-keyed by IP + normalized email)
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000   # 15 minutes window
RATE_LIMIT_ADMIN_LOGIN_MAX=10             # Max 10 attempts per account/IP

# Administrator Mutations & Sensitive Desk Actions (status changes, disputes, payouts, certificate issue/revoke)
RATE_LIMIT_ADMIN_ACTIONS_WINDOW_MS=900000 # 15 minutes window
RATE_LIMIT_ADMIN_ACTIONS_MAX=120          # Max 120 actions per 15 minutes

# Public Authentication & Password Reset
RATE_LIMIT_AUTH_WINDOW_MS=900000          # 15 minutes window
RATE_LIMIT_AUTH_MAX=30                    # Max 30 requests in production (300 in dev)

# Public Product Certificate Verification & QR Scan Ingestion
RATE_LIMIT_VERIFY_WINDOW_MS=60000         # 1 minute window
RATE_LIMIT_VERIFY_MAX=120                 # Max 120 verification queries/min (~2/sec)

# Public Uploads & KYC Documents
RATE_LIMIT_UPLOADS_WINDOW_MS=900000       # 15 minutes window
RATE_LIMIT_UPLOADS_MAX=50                 # Max 50 upload requests per 15 mins

# Financial Transactions & Escrow Orders (Deposit, Withdraw, Escrow Orders)
RATE_LIMIT_FINANCIAL_WINDOW_MS=900000     # 15 minutes window
RATE_LIMIT_FINANCIAL_MAX=40               # Max 40 financial requests per 15 mins

# ==============================================================================
# 4. OPTIONAL FEATURE INTEGRATIONS (Features gracefully disable if omitted)
# ==============================================================================

# Public Media Uploads (Cloudinary)
# If omitted, local server storage is used (not recommended on ephemeral containers).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Rails (Stripe)
# Required only for fiat credit/debit card checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Web3 & Blockchain On-Chain Anchoring (Ethereum / Sepolia)
# If omitted, certificates remain cryptographically verified off-chain.
SEPOLIA_RPC_URL=
SEPOLIA_RELAYER_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=

# 3D Asset Reconstruction (Tripo 3D)
TRIPO_API_KEY=

# Retail Market Price Intelligence (SerpApi)
SERPAPI_KEY=

# AI & Assistant Features
GEMINI_API_KEY=
