# ─── SmartAssets Backend Environment Variables Template ────────────────────────
# Copy this file to .env and populate with genuine values for your deployment.
# NEVER commit real credentials, service-role keys, or signing secrets to git.

# Server Port
PORT=5000

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Obtain from your Supabase project dashboard: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Administrator Authentication & JWT Signing ──────────────────────────────
# REQUIRED: Cryptographic HMAC-SHA256 secret for signing administrator session tokens.
# Must be at least 32 characters (256-bit entropy).
# Generate securely via terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse the Supabase service-role key or use predictable/default strings.
ADMIN_JWT_SECRET=

# ─── External Public URLs ─────────────────────────────────────────────────────
# Canonical base URL for public product certificate verification portal
# In production: must be a public HTTPS domain (e.g. https://verify.smartassets.io)
# In development: http://<your-local-ip>:5000
PUBLIC_WEB_BASE_URL=

# ─── Web3 & Blockchain (Optional / Network Anchoring) ─────────────────────────
# Sepolia Testnet RPC provider endpoint (Chain ID 11155111)
SEPOLIA_RPC_URL=
# 32-byte hexadecimal private key for the on-chain relayer wallet (exclude in read-only setups)
SEPOLIA_RELAYER_PRIVATE_KEY=

# ─── Media Storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payment Rails (Stripe) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ─── Security Headers, CORS, and Network Proxy Trust ──────────────────────────
# Comma-separated list of permitted production origins for CORS (e.g. https://admin.smartassets.io,https://app.smartassets.io)
# In development, local development origins (localhost, 127.0.0.1, Expo 8081/19006, LAN) are automatically allowed.
# In production, ONLY explicit origins listed here are accepted (wildcards are blocked).
CORS_ALLOWED_ORIGINS=https://app.smartassets.io,https://admin.smartassets.io

# Reverse proxy trust level for cloud hosts (Render, Cloudflare, AWS ALB, Nginx)
# Options: 1 (single reverse proxy hop), true, false, or comma-separated IP/CIDR subnets (e.g. loopback, 10.0.0.0/8)
TRUST_PROXY=1

# Enforce HTTP Strict Transport Security (HSTS)
# Set to 'true' ONLY when production HTTPS is terminated at the proxy/load-balancer.
ENFORCE_HSTS=false

# ─── Rate Limiting Configuration ──────────────────────────────────────────────
# Administrator Login (dual-keyed by IP + normalized email)
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000   # 15 minutes window
RATE_LIMIT_ADMIN_LOGIN_MAX=10             # Max 10 attempts per account/IP

# Administrator Mutations & Sensitive Desk Actions (status changes, disputes, payouts)
RATE_LIMIT_ADMIN_ACTIONS_WINDOW_MS=900000 # 15 minutes window
RATE_LIMIT_ADMIN_ACTIONS_MAX=120          # Max 120 actions per 15 minutes

# Public Authentication & Password Reset
RATE_LIMIT_AUTH_WINDOW_MS=900000          # 15 minutes window
RATE_LIMIT_AUTH_MAX=30                    # Max 30 requests in production (300 in dev)

# Public Product Certificate Verification & QR Scan Ingestion
RATE_LIMIT_VERIFY_WINDOW_MS=60000         # 1 minute window
RATE_LIMIT_VERIFY_MAX=120                 # Max 120 verification queries/min (~2/sec)

# Public Uploads & KYC Documents
RATE_LIMIT_UPLOADS_WINDOW_MS=900000       # 15 minutes window
RATE_LIMIT_UPLOADS_MAX=50                 # Max 50 upload requests per 15 mins

# Financial Transactions & Escrow Orders (Deposit, Withdraw, Escrow Orders)
RATE_LIMIT_FINANCIAL_WINDOW_MS=900000     # 15 minutes window
RATE_LIMIT_FINANCIAL_MAX=40               # Max 40 financial requests per 15 mins

# ─── AI & External APIs ───────────────────────────────────────────────────────
TRIPO_API_KEY=
SERPAPI_KEY=
GEMINI_API_KEY=

