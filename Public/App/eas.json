{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smartassets.onrender.com/api",
        "PUBLIC_WEB_BASE_URL": "https://smartassets.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smartassets.onrender.com/api",
        "PUBLIC_WEB_BASE_URL": "https://smartassets.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smartassets.onrender.com/api",
        "PUBLIC_WEB_BASE_URL": "https://smartassets.onrender.com"
      }
    }
  }
}
