# ─── SmartAssets Mobile App Environment Config ──────────────────────────────
# Local development or production Render backend URL:
# Example (Local): http://localhost:5000/api
# Example (Production): https://smartassets.onrender.com/api
EXPO_PUBLIC_API_BASE_URL=https://smartassets.onrender.com/api

# Public Canonical Product Verification Base URL
# In Production: Must be an HTTPS URL hosting the public verification page (e.g. https://smartassets.onrender.com)
# In Development: Can be your local backend server URL (e.g. http://localhost:5000)
EXPO_PUBLIC_VERIFICATION_BASE_URL=https://smartassets.onrender.com
PUBLIC_WEB_BASE_URL=https://smartassets.onrender.com
